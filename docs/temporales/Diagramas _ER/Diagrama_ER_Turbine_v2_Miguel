# Diagrama entidad-relación — Turbine V2

## Modelo 2

Se añaden contactos, tarifas por nivel, propuestas comerciales, series, aprobaciones, PDF, envíos, cambios de estado, recordatorios, incidencias, pausas y notificaciones. También se incorporan los datos fiscales históricos, las rectificativas y las marcas de factura migrada o incobrable (FR6, FR8, FR10, FR14–FR22; CU-11–CU-12, CU-18–CU-27 y CU-31–CU-33).

```plantuml
@startuml
title Turbine - Modelo entidad-relacion V2 (funcional)
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle

package "Clientes y suscripciones" {
  entity Usuario {
    * id_usuario : bigint <<PK>>
    --
    * nombre : varchar
    * correo : varchar <<UQ>>
    * rol : varchar
    * estado : varchar
  }
  entity Cliente {
    * id_cliente : bigint <<PK>>
    --
    * id_responsable : bigint <<FK>>
    * razon_social : varchar
    * nombre_comercial : varchar
    * identificador_fiscal : varchar <<UQ>>
    domicilio_fiscal : varchar
    representante_legal : varchar
    * pais : char(2)
    * moneda : char(3)
    facturacion_anual : decimal
    * estado : varchar
  }
  entity Contacto {
    * id_contacto : bigint <<PK>>
    --
    * id_cliente : bigint <<FK>>
    nombre : varchar
    correo : varchar
    telefono : varchar
    * tipo : varchar
    * activo : boolean
  }
  entity Tarifa {
    * id_tarifa : bigint <<PK>>
    --
    * nivel : varchar
    * rango_desde : decimal
    rango_hasta : decimal
    * cuota_mensual : decimal
    * moneda : char(3)
    * vigente_desde : date
    vigente_hasta : date
  }
  entity Suscripcion {
    * id_suscripcion : bigint <<PK>>
    --
    * id_cliente : bigint <<FK>>
    * id_tarifa : bigint <<FK>>
    * fecha_inicio : date
    fecha_fin : date
    motivo_pausa : varchar
    fecha_reactivacion : date
    * estado : varchar
  }
  entity PropuestaComercial {
    * id_propuesta : bigint <<PK>>
    --
    * id_suscripcion : bigint <<FK>>
    id_tarifa_propuesta : bigint <<FK>>
    * tipo : varchar
    importe : decimal
    porcentaje : decimal
    * motivo : text
    * vigente_desde : date
    vigente_hasta : date
  }
}

package "Facturacion y aprobaciones" {
  entity SerieFactura {
    * id_serie : bigint <<PK>>
    --
    * codigo : varchar <<UQ>>
    * siguiente_numero : bigint
    * activa : boolean
  }
  entity Factura {
    * id_factura : bigint <<PK>>
    --
    * id_cliente : bigint <<FK>>
    id_suscripcion : bigint <<FK>>
    id_serie : bigint <<FK>>
    id_original : bigint <<FK>>
    id_creador : bigint <<FK>>
    numero : bigint
    * tipo : varchar
    periodo_servicio : date
    fecha_emision : date
    fecha_vencimiento : date
    * base_imponible : decimal
    * total_impuestos : decimal
    * importe_total : decimal
    * moneda : char(3)
    * estado : varchar
    * migrada : boolean
    * incobrable : boolean
    datos_fiscales_emitidos : json
  }
  entity LineaFactura {
    * id_linea : bigint <<PK>>
    --
    * id_factura : bigint <<FK>>
    * concepto : varchar
    * cantidad : decimal
    * precio_unitario : decimal
    * descuento_pct : decimal
    * impuesto_pct : decimal
  }
  entity Aprobacion {
    * id_aprobacion : bigint <<PK>>
    --
    id_factura : bigint <<FK>>
    id_propuesta : bigint <<FK>>
    id_solicitante : bigint <<FK>>
    id_administrador : bigint <<FK>>
    * motivo_retencion : text
    * estado : varchar
    * fecha_solicitud : timestamp
    fecha_resolucion : timestamp
    motivo_decision : text
  }
  entity DocumentoFactura {
    * id_documento : bigint <<PK>>
    --
    * id_factura : bigint <<FK,UQ>>
    * ruta_local : varchar
    * ruta_nube : varchar
    * huella_pdf : varchar
    * fecha_firma : timestamp
  }
  entity EnvioFactura {
    * id_envio : bigint <<PK>>
    --
    * id_factura : bigint <<FK>>
    id_contacto : bigint <<FK>>
    * destinatario_historico : varchar
    * canal : varchar
    * fecha : timestamp
    * resultado : varchar
    detalle_error : text
  }
  entity CambioEstadoFactura {
    * id_cambio : bigint <<PK>>
    --
    * id_factura : bigint <<FK>>
    id_usuario : bigint <<FK>>
    estado_anterior : varchar
    * estado_nuevo : varchar
    * fecha : timestamp
  }
}

package "Cobros y seguimiento" {
  entity Cobro {
    * id_cobro : bigint <<PK>>
    --
    id_factura : bigint <<FK>>
    * origen : varchar
    * referencia_externa : varchar
    * fecha : timestamp
    * importe : decimal
    * moneda : char(3)
    * estado : varchar
    motivo_revision : text
  }
  entity Recordatorio {
    * id_recordatorio : bigint <<PK>>
    --
    * id_factura : bigint <<FK>>
    * fecha : timestamp
    * canal : varchar
    * destinatario_historico : varchar
    * resultado : varchar
  }
  entity Incidencia {
    * id_incidencia : bigint <<PK>>
    --
    * id_cliente : bigint <<FK>>
    id_factura : bigint <<FK>>
    * id_responsable : bigint <<FK>>
    * descripcion : text
    * prioridad : varchar
    * estado : varchar
    * fecha_apertura : timestamp
    fecha_cierre : timestamp
  }
  entity PausaRecordatorios {
    * id_pausa : bigint <<PK>>
    --
    * id_factura : bigint <<FK>>
    id_incidencia : bigint <<FK>>
    * id_usuario : bigint <<FK>>
    * motivo : text
    * fecha_inicio : timestamp
    * fecha_revision : date
    fecha_reanudacion : timestamp
  }
  entity Notificacion {
    * id_notificacion : bigint <<PK>>
    --
    * id_destinatario : bigint <<FK>>
    id_cliente : bigint <<FK>>
    * tipo : varchar
    * mensaje : text
    * prioridad : varchar
    * estado : varchar
    * fecha : timestamp
  }
}

Usuario ||--o{ Cliente : responsable
Cliente ||--o{ Contacto
Cliente ||--o{ Suscripcion
Tarifa ||--o{ Suscripcion
Suscripcion ||--o{ PropuestaComercial
Tarifa |o--o{ PropuestaComercial : propuesta
Cliente ||--o{ Factura
Suscripcion |o--o{ Factura
SerieFactura |o--o{ Factura
Factura |o--o{ Factura : original / rectificativa
Usuario |o--o{ Factura : crea
Factura ||--o{ LineaFactura
Factura |o--o{ Aprobacion
PropuestaComercial |o--o{ Aprobacion
Usuario |o--o{ Aprobacion : solicita
Usuario |o--o{ Aprobacion : resuelve
Factura ||--o| DocumentoFactura
Factura ||--o{ EnvioFactura
Contacto |o--o{ EnvioFactura
Factura ||--o{ CambioEstadoFactura
Usuario |o--o{ CambioEstadoFactura
Factura |o--o{ Cobro
Factura ||--o{ Recordatorio
Cliente ||--o{ Incidencia
Factura |o--o{ Incidencia
Usuario ||--o{ Incidencia
Factura ||--o{ PausaRecordatorios
Incidencia |o--o{ PausaRecordatorios
Usuario ||--o{ PausaRecordatorios
Usuario ||--o{ Notificacion
Cliente |o--o{ Notificacion

note right of Factura
  UQ(serie, numero) al emitir.
  Una recurrente por suscripcion y periodo.
  Datos fiscales y lineas congelados al emitir.
end note
note right of Aprobacion
  Factura XOR propuesta comercial.
  El creador no puede aprobar.
end note
note bottom of Cobro
  UQ(origen, referencia_externa).
  Puede estar pendiente de conciliacion.
end note
@enduml
```
