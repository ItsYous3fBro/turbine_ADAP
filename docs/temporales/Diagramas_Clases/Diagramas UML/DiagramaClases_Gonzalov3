  BackgroundColor white
  BorderColor black
}

skinparam class {
  BackgroundColor #F4F8FF
  BorderColor #4A709C
  HeaderBackgroundColor #D4E3F7
}

package "Usuarios y acceso" {
  enum Rol {
    ESTANDAR
    ADMINISTRADOR
    SUPERADMINISTRADOR
  }

  enum EstadoCuenta {
    INVITADA
    ACTIVA
    BLOQUEADA
  }

  class Usuario {
    -id : Long
    -nombre : String
    -email : String
    -rol : Rol
    -estado : EstadoCuenta
    +autenticar(contrasena : String) : Boolean
  }

  abstract class TokenTemporal {
    -token : String
    -fechaCaducidad : DateTime
    +estaVigente() : Boolean
  }

  class EnlaceRecuperacion extends TokenTemporal
  class Invitacion extends TokenTemporal

  class CredencialAPI {
    -sistema : String
    -activa : Boolean
  }
}

package "Configuración y análisis" {
  class PlantillaMensaje {
    -tipo : String
    -texto : String
  }

  class Exportacion {
    -tipoInforme : String
    -formato : String
  }

  class ParametroConfiguracion {
    -clave : String
    -valor : String
  }
}

package "Clientes y suscripciones" {
  class Importacion {
    -filasValidas : Integer
    -filasErroneas : Integer
  }

  class Delegacion {
    -fechaInicio : Date
    -fechaFin : Date
  }

  class Cliente {
    -id : Long
    -razonSocial : String
    -facturacionAnual : Decimal
    +calcularDeuda() : Decimal
  }

  class Suscripcion {
    -fechaInicio : Date
    -estado : String
    +calcularCuotaMensual() : Decimal
  }

  class Contacto {
    -nombre : String
    -email : String
  }

  class ExcepcionComercial implements Aprobable {
    -valor : Decimal
    -motivo : String
  }

  class PropuestaCambioNivel implements Aprobable {
    -facturacionAnual : Decimal
  }

  class NivelTarifa {
    -nombre : String
    -cuotaMensual : Decimal
  }
}

package "Facturación y aprobaciones" {
  class PeriodoFacturacion {
    -fechaInicio : Date
    -cerrado : Boolean
    +cerrar() : void
  }

  class Factura implements Aprobable {
    -numero : String
    -fechaEmision : Date
    -estado : String
    -total : Decimal
    +emitir(numero : String) : void
  }

  class FacturaRectificativa extends Factura {
    -motivo : String
  }

  interface Aprobable {
    +requiereAprobacion() : Boolean
    +aplicarAprobacion() : void
  }

  class SolicitudAprobacion {
    -motivo : String
    -estado : String
    +aprobar(aprobador : Usuario) : void
  }

  class LineaFactura {
    -descripcion : String
    -cantidad : Decimal
    -precioUnitario : Decimal
  }
  
  class Concepto {
    -nombre : String
    -precioBase : Decimal
  }
}

package "Seguimiento e Incidencias" {
  class Notificacion {
    -mensaje : String
    -leida : Boolean
  }

  class Incidencia {
    -descripcion : String
    -prioridad : String
    -estado : String
  }

  class Comentario {
    -texto : String
    -fecha : DateTime
  }

  class RegistroAuditoria {
    -accion : String
    -entidad : String
  }
}

package "Envíos y cobros" {
  class Envio {
    -fecha : DateTime
    -resultado : String
  }

  class Cobro {
    -importe : Decimal
    -fecha : Date
    -referencia : String
  }
}

