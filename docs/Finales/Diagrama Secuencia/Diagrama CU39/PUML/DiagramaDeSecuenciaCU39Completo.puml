@startuml
title CU-39 · Exportar informes y datos (versión completa)

actor "Usuario estándar" as emp
participant "Interfaz web" as ui
participant "Dashboard\ne informes" as infComp
participant "exp : Exportacion" as exp
participant "prog : ProgramacionInforme" as prog
participant "Auditoría" as aud
database "Base de datos" as db

alt Flujo alternativo 1a: Programar el envío periódico (CU-40)
    emp -> ui : 1a.1: programarExportacion(tipoInforme, filtros, formato, destinatarios, periodicidad)
    activate ui
    ui -> infComp : 1a.2: programarInforme(tipoInforme, filtros, formato, destinatarios, periodicidad) [IInformes]
    activate infComp
    infComp -> prog ** : 1a.3: crear(tipoInforme, periodicidad, destinatarios)
    activate prog
    infComp -> db : 1a.4: guardarProgramacionInforme(prog) [IDatabase]
    activate db
    db --> infComp : guardada
    deactivate db
    deactivate prog
    infComp -> aud : 1a.5: registrarAuditoria("PROGRAMAR_INFORME", prog) [ILog]
    activate aud
    aud -> db : 1a.6: guardarRegistroAuditoria() [IDatabase]
    activate db
    db --> aud : registrado
    deactivate db
    deactivate aud
    infComp --> ui : Programación guardada (se ejecutará en CU-40)
    ui --> emp : Confirma programación del envío periódico
    deactivate infComp
    deactivate ui

else Flujo alternativo 1b: Regenerar una exportación caducada
    emp -> ui : 1b.1: solicitarRegenerarExportacion(idExportacion)
    activate ui
    ui -> infComp : 1b.2: regenerarExportacion(idExportacion) [IInformes]
    activate infComp
    infComp -> db : 1b.3: comprobarExportacionYPermisos(idExportacion, usuario) [IDatabase]
    activate db
    db --> infComp : exportacionCaducada, datosYPermisosPermitidos
    deactivate db

    alt Datos y permisos actuales lo permiten (FR2, FR25)
        infComp -> db : 1b.4: consultarDatosPermitidos(tipoInforme, filtros, permisosUsuario) [IDatabase]
        activate db
        db --> infComp : datosFiltrados
        deactivate db
        infComp -> exp ** : 1b.5: crear(tipoInforme, formato, filtros)
        activate exp
        infComp -> exp : 1b.6: generar()
        exp --> infComp : archivoGenerado
        infComp -> db : 1b.7: guardarExportacion(exp) [IDatabase]
        activate db
        db --> infComp : guardada
        deactivate db
        infComp -> aud : 1b.8: registrarAuditoria("REGENERAR_EXPORTACION", exp) [ILog]
        activate aud
        aud -> db : 1b.9: guardarRegistroAuditoria() [IDatabase]
        activate db
        db --> aud : registrado
        deactivate db
        deactivate aud
        infComp --> ui : Exportación regenerada y disponible
        deactivate exp
        ui --> emp : Permite descargar el informe regenerado
    else Datos o permisos no lo permiten
        infComp --> ui : No es posible regenerar con los datos o permisos actuales
        ui --> emp : Informa del motivo
    end

    deactivate infComp
    deactivate ui

else Escenario principal: Exportar informe o datos (pasos 1 a 4)
    emp -> ui : 1: seleccionarInformeYFiltros(tipoInforme, filtros)
    activate ui
    emp -> ui : 2: seleccionarFormato(formato)
    note right of ui
      Formatos admitidos:
      CSV (UTF-8) o PDF (FR25)
    end note
    ui -> infComp : 3: exportarInforme(tipoInforme, filtros, formato) [IInformes]
    activate infComp

    infComp -> db : 3.1: consultarDatosPermitidos(tipoInforme, filtros, permisosUsuario) [IDatabase]
    activate db
    db --> infComp : datosFiltrados
    deactivate db

    alt Excepción 3a: La exportación no contiene datos
        infComp --> ui : Aviso: La exportación no contiene datos
        ui --> emp : Informa y no genera archivo
    else Existen datos permitidos (FR2, FR25, NFR12)
        infComp -> exp ** : 3.2: crear(tipoInforme, formato, filtros)
        activate exp
        infComp -> exp : 3.3: generar()
        exp --> infComp : archivoListo
        infComp -> db : 3.4: guardarExportacion(exp) [IDatabase]
        activate db
        db --> infComp : guardada
        deactivate db
        infComp -> aud : 3.5: registrarAuditoria("EXPORTAR_INFORME", exp) [ILog]
        activate aud
        aud -> db : 3.6: guardarRegistroAuditoria() [IDatabase]
        activate db
        db --> aud : registrado
        deactivate db
        deactivate aud
        infComp --> ui : 4: disponibilidadExportacion(exp)
        deactivate exp
        ui --> emp : Pone el archivo disponible para descarga (NFR4, NFR6)

        opt Descargar exportación
            emp -> ui : descargarExportacion(idExportacion)
            ui -> exp : descargar()
            activate exp
            exp --> ui : archivo
            deactivate exp
            ui --> emp : Entrega CSV o PDF
        end
    end

    deactivate infComp
    deactivate ui
end
@enduml