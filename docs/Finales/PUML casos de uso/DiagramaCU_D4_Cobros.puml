@startuml DiagramaCU_D4_Cobros
title D4 · Cobros
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F8FF
  BorderColor #3B6FD8
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}
actor "Administrador" as AD
actor "Temporizador" as TM
actor "Pasarela de pago\n(Stripe)" as PP
actor "Cliente" as CL
actor "Proveedor de correo" as PC

rectangle "Gestor de facturas Turbine" {
  usecase "CU-27 Enviar recordatorios\nde cobro" as CU27
  usecase "CU-28 Registrar cobro\nde la pasarela" as CU28
  usecase "CU-29 Conciliar cobros" as CU29
  usecase "CU-30 Vincular cobro\ncon factura" as CU30
}
TM --> CU27
CU27 --> CL
CU27 --> PC
PP --> CU28
AD --> CU29
CU28 ..> CU30 : <<include>>
CU29 ..> CU30 : <<include>>
@enduml
