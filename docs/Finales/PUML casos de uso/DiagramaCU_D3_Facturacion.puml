@startuml DiagramaCU_D3_Facturacion
title D3 · Facturación y aprobaciones
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F8FF
  BorderColor #3B6FD8
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}
actor "Usuario estándar" as US
actor "Administrador" as AD
actor "Temporizador" as TM
actor "Cliente" as CL
actor "Proveedor de correo" as PC
AD -|> US

rectangle "Gestor de facturas Turbine" {
  usecase CU17 as "CU-17 Crear factura puntual
--
puntos de extensión:
aprobación (paso 7)"
  usecase "CU-18 Generar facturas\nrecurrentes" as CU18
  usecase CU24 as "CU-24 Rectificar o anular
factura
--
puntos de extensión:
aprobación (paso 6)"
  usecase "CU-19 Emitir factura" as CU19
  usecase "CU-20 Retener para\naprobación" as CU20
  usecase CU21 as "CU-21 Resolver aprobación
pendiente
--
puntos de extensión:
aprobación concedida (paso 4)"
  usecase "CU-22 Enviar factura" as CU22
  usecase "CU-23 Reenviar factura" as CU23
  usecase "CU-25 Declarar factura\nincobrable" as CU25
  usecase "CU-26 Cerrar periodo\nde facturación" as CU26
  usecase "CU-27 Consultar facturas\ny estado de cobro" as CU27
  usecase "CU-47 Registrar rebote\nde envío" as CU47
}
US --> CU17
US --> CU23
US --> CU27
TM --> CU18
AD --> CU21
AD --> CU24
AD --> CU25
AD --> CU26
PC --> CU47
CU22 --> CL
CU22 --> PC
CU17 ..> CU19 : <<include>>
CU18 ..> CU19 : <<include>>
CU24 ..> CU19 : <<include>>
CU19 ..> CU22 : <<include>>
CU23 ..> CU22 : <<include>>
CU20 ..> CU17 : <<extend>>
note on link
  condición de retención
  (definida en CU-20)
end note
CU20 ..> CU24 : <<extend>>
note on link
  condición de retención
  (definida en CU-20)
end note
CU19 ..> CU21 : <<extend>>
note on link
  condición: la operación
  aprobada es una factura
  o una rectificativa
end note
@enduml
