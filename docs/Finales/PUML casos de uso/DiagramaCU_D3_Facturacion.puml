@startuml DiagramaCU_D3_Facturacion
title D3 · Facturación y aprobaciones
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F8FF
  BorderColor #3B6FD8
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}
actor "Usuario estándar" as US
actor "Administrador" as AD
actor "Temporizador" as TM
actor "Cliente" as CL
actor "Proveedor de correo" as PC
AD -|> US

rectangle "Gestor de facturas Turbine" {
  usecase CU15 as "CU-15 Crear factura puntual
--
puntos de extensión:
aprobación (paso 7)"
  usecase "CU-16 Generar facturas\nrecurrentes" as CU16
  usecase CU22 as "CU-22 Rectificar o anular
factura
--
puntos de extensión:
aprobación (paso 6)"
  usecase "CU-17 Emitir factura" as CU17
  usecase "CU-18 Retener para\naprobación" as CU18
  usecase CU19 as "CU-19 Resolver aprobación
pendiente
--
puntos de extensión:
aprobación concedida (paso 4)"
  usecase "CU-20 Enviar factura" as CU20
  usecase "CU-21 Reenviar factura" as CU21
  usecase "CU-23 Declarar factura\nincobrable" as CU23
  usecase "CU-24 Cerrar periodo\nde facturación" as CU24
  usecase "CU-25 Consultar facturas\ny estado de cobro" as CU25
  usecase "CU-26 Registrar rebote\nde envío" as CU26
}
US --> CU15
US --> CU21
US --> CU25
TM --> CU16
AD --> CU19
AD --> CU22
AD --> CU23
AD --> CU24
PC --> CU26
CU20 --> CL
CU20 --> PC
CU15 ..> CU17 : <<include>>
CU16 ..> CU17 : <<include>>
CU22 ..> CU17 : <<include>>
CU17 ..> CU20 : <<include>>
CU21 ..> CU20 : <<include>>
CU18 ..> CU15 : <<extend>>
note on link
  condición de retención
  (definida en CU-18)
end note
CU18 ..> CU22 : <<extend>>
note on link
  condición de retención
  (definida en CU-18)
end note
CU17 ..> CU19 : <<extend>>
note on link
  condición: la operación
  aprobada es una factura
  o una rectificativa
end note
@enduml
