@startuml DiagramaCU_D6_Control
title D6 · Información y configuración
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F8FF
  BorderColor #3B6FD8
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}
actor "Usuario estándar" as US
actor "Administrador" as AD
actor "Superadministrador" as SA
actor "Temporizador" as TM
actor "Gestoría" as GE
AD -|> US
SA -|> AD

rectangle "Gestor de facturas Turbine" {
  usecase "CU-37 Consultar dashboard\nfinanciero" as CU37
  usecase "CU-38 Definir objetivos\nfinancieros" as CU38
  usecase "CU-39 Exportar informes\ny datos" as CU39
  usecase "CU-40 Enviar informes\nprogramados" as CU40
  usecase "CU-41 Supervisar el sistema" as CU41
  usecase "CU-42 Configurar el sistema" as CU42
}
US --> CU39
AD --> CU37
AD --> CU38
TM --> CU40
CU40 --> GE
SA --> CU41
SA --> CU42
@enduml
