@startuml DiagramaCU_D2_Clientes
title D2 · Clientes y suscripciones
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F8FF
  BorderColor #3B6FD8
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}
actor "Usuario estándar" as US
actor "Administrador" as AD
actor "Temporizador" as TM
actor "Sistema externo" as EXT
actor "Pasarela de pago\n(Stripe)" as PP
AD -|> US

rectangle "Gestor de facturas Turbine" {
  usecase "CU-07 Gestionar cliente" as CU07
  usecase "CU-08 Importar datos\ndesde CSV" as CU08
  usecase CU09 as "CU-09 Gestionar suscripción
--
puntos de extensión:
prorrateo (paso 6)"
  usecase "CU-10 Facturar prorrateo" as CU10
  usecase "CU-11 Proponer excepción\ncomercial" as CU11
  usecase "CU-12 Proponer revisión\nanual de tarifa" as CU12
  usecase "CU-13 Consultar deuda\nde cliente" as CU13
  usecase "CU-14 Solicitar baja\npor API" as CU14
  usecase "CU-17 Emitir factura" as CU17
  usecase "CU-18 Retener para\naprobación" as CU18
}
US --> CU07
US --> CU09
US --> CU11
AD --> CU08
TM --> CU12
EXT --> CU13
EXT --> CU14
CU10 --> PP
CU10 ..> CU09 : <<extend>>
note on link
  condición: alta a
  mitad de periodo
end note
CU10 ..> CU17 : <<include>>
CU11 ..> CU18 : <<include>>
CU12 ..> CU18 : <<include>>
note "CU-17 y CU-18 se\ndetallan en D3" as N1
@enduml
