@startuml DiagramaCU_D2_Clientes
title D2 · Clientes y suscripciones
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F8FF
  BorderColor #3B6FD8
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}
actor "Usuario estándar" as US
actor "Administrador" as AD
actor "Temporizador" as TM
actor "Sistema externo" as EXT
actor "Pasarela de pago\n(Stripe)" as PP
AD -|> US

rectangle "Gestor de facturas Turbine" {
  usecase "CU-07 Registrar cliente" as CU07
  usecase "CU-08 Consultar y actualizar\nficha de cliente" as CU08
  usecase "CU-09 Importar datos\ndesde CSV" as CU09
  usecase CU10 as "CU-10 Gestionar suscripción
--
puntos de extensión:
prorrateo (paso 6)"
  usecase "CU-11 Facturar prorrateo" as CU11
  usecase "CU-12 Proponer excepción\ncomercial" as CU12
  usecase "CU-13 Proponer revisión\nanual de tarifa" as CU13
  usecase "CU-14 Dar de baja cliente" as CU14
  usecase "CU-15 Consultar deuda\nde cliente" as CU15
  usecase "CU-16 Solicitar baja\npor API" as CU16
  usecase "CU-19 Emitir factura" as CU19
  usecase "CU-20 Retener para\naprobación" as CU20
}
US --> CU07
US --> CU08
US --> CU10
US --> CU12
US --> CU14
AD --> CU09
TM --> CU13
EXT --> CU15
EXT --> CU16
CU11 --> PP
CU11 ..> CU10 : <<extend>>
note on link
  condición: alta a
  mitad de periodo
end note
CU11 ..> CU19 : <<include>>
CU12 ..> CU20 : <<include>>
CU13 ..> CU20 : <<include>>
note "CU-19 y CU-20 se\ndetallan en D3" as N1
@enduml
