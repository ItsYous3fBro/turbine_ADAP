@startuml DiagramaER_Anexo_Completo
title Diagrama físico Entidad-Relación · Anexo: modelo completo\nGestor de facturas Turbine · versión final (fusión) · 38 tablas · notación pata de gallo · PostgreSQL
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #F5F8FF
  BorderColor #3B6FD8
}
legend right
  * = NOT NULL · <<PK>> clave primaria · <<FK>> clave foránea · <<UK>> único
  ||  exactamente uno · |o  cero o uno · |{  uno o más · o{  cero o más
  Columnas de tipo enumerado (rol, estado, tipo…): VARCHAR + CHECK con los valores del diagrama de clases
  Importes NUMERIC(12,2) · fechas con hora TIMESTAMPTZ (UTC) · claves BIGINT autonuméricas
  Sección «restricciones»: CHECK, únicos compuestos e índices (IDX) de cada tabla
  Claves foráneas: ON DELETE RESTRICT salvo las marcadas CASCADE (composiciones y herencia)
endlegend

package "Usuarios y acceso" {
  entity "usuario" as usuario {
    *id : BIGINT <<PK>>
    --
    *nombre : VARCHAR(100)
    *email : VARCHAR(150) <<UK>>
    hash_contrasena : VARCHAR(255)
    cuenta_microsoft : VARCHAR(150) <<UK>>
    *rol : VARCHAR(20)
    *estado : VARCHAR(20)
    *intentos_fallidos : INTEGER
    bloqueado_hasta : TIMESTAMPTZ
    .. restricciones ..
    CHECK intentos_fallidos >= 0
  }
  entity "sesion" as sesion {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>> CASCADE
    *creada_en : TIMESTAMPTZ
    *ultima_actividad : TIMESTAMPTZ
    *expira_en : TIMESTAMPTZ
    *activa : BOOLEAN
    .. restricciones ..
    IDX (usuario_id) WHERE activa
  }
  entity "token_temporal" as token {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>> CASCADE
    *tipo : VARCHAR(20)
    *token_hash : VARCHAR(255) <<UK>>
    *fecha_caducidad : TIMESTAMPTZ
    *usado : BOOLEAN
    .. restricciones ..
    CHECK tipo IN ('INVITACION','RECUPERACION')
  }
  entity "credencial_api" as credencial {
    *id : BIGINT <<PK>>
    --
    *sistema : VARCHAR(100) <<UK>>
    *hash_clave : VARCHAR(255)
    *activa : BOOLEAN
    ultimo_uso : TIMESTAMPTZ
  }
  entity "notificacion" as notificacion {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>>
    cliente_id : BIGINT <<FK>>
    factura_id : BIGINT <<FK>>
    incidencia_id : BIGINT <<FK>>
    solicitud_baja_id : BIGINT <<FK>>
    *tipo : VARCHAR(30)
    *mensaje : TEXT
    *prioridad : VARCHAR(10)
    *fecha : TIMESTAMPTZ
    *leida : BOOLEAN
    *atendida : BOOLEAN
    .. restricciones ..
    CHECK num_nonnulls(cliente_id, factura_id,
      incidencia_id, solicitud_baja_id) <= 1
    IDX (usuario_id, atendida)
  }
  entity "vista_guardada" as vista {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>> CASCADE
    *nombre : VARCHAR(100)
    *filtros : JSONB
    *predeterminada : BOOLEAN
    .. restricciones ..
    UNIQUE (usuario_id, nombre)
    UNIQUE (usuario_id) WHERE predeterminada
  }
}

package "Clientes y suscripciones" {
  entity "cliente" as cliente {
    *id : BIGINT <<PK>>
    --
    *responsable_id : BIGINT <<FK>>
    *nombre_comercial : VARCHAR(150)
    razon_social : VARCHAR(150)
    identificador_fiscal : VARCHAR(20) <<UK>>
    domicilio : VARCHAR(255)
    pais : CHAR(2)
    *moneda : CHAR(3)
    representante_legal : VARCHAR(150)
    facturacion_anual : NUMERIC(12,2)
    *fecha_alta : DATE
    *estado : VARCHAR(20)
    .. restricciones ..
    IDX (nombre_comercial)
  }
  entity "contacto" as contacto {
    *id : BIGINT <<PK>>
    --
    *cliente_id : BIGINT <<FK>> CASCADE
    *nombre : VARCHAR(100)
    *email : VARCHAR(150)
    telefono : VARCHAR(20)
    *funcion : VARCHAR(20)
    *idioma : CHAR(2)
    *activo : BOOLEAN
  }
  entity "delegacion" as delegacion {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>>
    *cliente_id : BIGINT <<FK>>
    *autorizada_por_id : BIGINT <<FK>>
    *fecha_inicio : DATE
    *fecha_fin : DATE
    *estado : VARCHAR(20)
    .. restricciones ..
    CHECK fecha_fin >= fecha_inicio
    UNIQUE (cliente_id) WHERE estado = 'VIGENTE'
  }
  entity "nivel_tarifa" as nivel_tarifa {
    *id : BIGINT <<PK>>
    --
    *nombre : VARCHAR(50)
    *facturacion_minima : NUMERIC(12,2)
    facturacion_maxima : NUMERIC(12,2)
    *cuota_mensual : NUMERIC(12,2)
    *vigente_desde : DATE
    vigente_hasta : DATE
    .. restricciones ..
    CHECK facturacion_maxima > facturacion_minima
    CHECK cuota_mensual >= 0
  }
  entity "suscripcion" as suscripcion {
    *id : BIGINT <<PK>>
    --
    *cliente_id : BIGINT <<FK>>
    *nivel_tarifa_id : BIGINT <<FK>>
    *fecha_inicio : DATE
    fecha_fin : DATE
    *estado : VARCHAR(20)
    motivo_pausa : VARCHAR(255)
    fecha_reactivacion : DATE
    .. restricciones ..
    UNIQUE (cliente_id) WHERE estado <> 'CANCELADA'
  }
  entity "excepcion_comercial" as excepcion {
    *id : BIGINT <<PK>>
    --
    *suscripcion_id : BIGINT <<FK>>
    *tipo : VARCHAR(30)
    *valor : NUMERIC(12,2)
    *vigente_desde : DATE
    vigente_hasta : DATE
    *motivo : VARCHAR(255)
    .. restricciones ..
    CHECK vigente_hasta >= vigente_desde
  }
  entity "propuesta_cambio_nivel" as propuesta {
    *id : BIGINT <<PK>>
    --
    *suscripcion_id : BIGINT <<FK>>
    *nivel_propuesto_id : BIGINT <<FK>>
    *fecha : DATE
    *facturacion_anual : NUMERIC(12,2)
  }
  entity "solicitud_baja" as baja {
    *id : BIGINT <<PK>>
    --
    *cliente_id : BIGINT <<FK>>
    revisada_por_id : BIGINT <<FK>>
    credencial_api_id : BIGINT <<FK>>
    *origen : VARCHAR(10)
    *fecha_solicitud : TIMESTAMPTZ
    *motivo : VARCHAR(255)
    *estado : VARCHAR(20)
    .. restricciones ..
    CHECK origen <> 'API' OR credencial_api_id IS NOT NULL
    UNIQUE (cliente_id) WHERE estado = 'PENDIENTE'
  }
  entity "importacion" as importacion {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>>
    *tipo : VARCHAR(20)
    *fecha : TIMESTAMPTZ
    *filas_validas : INTEGER
    *filas_erroneas : INTEGER
    informe_errores : TEXT
  }
}

package "Facturación y aprobaciones" {
  entity "serie_facturacion" as serie {
    *id : BIGINT <<PK>>
    --
    *codigo : VARCHAR(10) <<UK>>
    *formato : VARCHAR(30)
    *ultimo_numero : INTEGER
    *activa : BOOLEAN
    .. restricciones ..
    CHECK ultimo_numero >= 0
  }
  entity "periodo_facturacion" as periodo {
    *id : BIGINT <<PK>>
    --
    cerrado_por_id : BIGINT <<FK>>
    *fecha_inicio : DATE <<UK>>
    *fecha_fin : DATE
    *estado : VARCHAR(20)
    cerrado_en : TIMESTAMPTZ
    .. restricciones ..
    CHECK (estado = 'CERRADO') = (cerrado_en IS NOT NULL)
  }
  entity "factura" as factura {
    *id : BIGINT <<PK>>
    --
    *cliente_id : BIGINT <<FK>>
    suscripcion_id : BIGINT <<FK>>
    serie_id : BIGINT <<FK>>
    periodo_id : BIGINT <<FK>>
    ejecucion_proceso_id : BIGINT <<FK>>
    creada_por_id : BIGINT <<FK>>
    numero : VARCHAR(20)
    fecha_emision : DATE
    fecha_vencimiento : DATE
    *tipo : VARCHAR(20)
    *estado : VARCHAR(25)
    periodo_servicio : VARCHAR(50)
    *moneda : CHAR(3)
    *subtotal : NUMERIC(12,2)
    *impuestos : NUMERIC(12,2)
    *total : NUMERIC(12,2)
    *migrada : BOOLEAN
    *incobrable : BOOLEAN
    datos_fiscales_emitidos : JSONB
    .. restricciones ..
    UNIQUE (serie_id, numero)
    UNIQUE (suscripcion_id, periodo_id) WHERE tipo = 'RECURRENTE'
    CHECK estado = 'BORRADOR' OR numero, serie_id, periodo_id,
      fecha_emision y datos_fiscales_emitidos NOT NULL
    CHECK total = subtotal + impuestos
    CHECK NOT incobrable OR estado = 'VENCIDA'
    IDX (cliente_id) · IDX (estado, fecha_vencimiento)
  }
  entity "factura_rectificativa" as rectificativa {
    *factura_id : BIGINT <<PK, FK>> CASCADE
    --
    *factura_original_id : BIGINT <<FK>>
    *motivo : VARCHAR(255)
    *anula_totalmente : BOOLEAN
    .. restricciones ..
    CHECK factura_id <> factura_original_id
  }
  entity "linea_factura" as linea {
    *id : BIGINT <<PK>>
    --
    *factura_id : BIGINT <<FK>> CASCADE
    concepto_id : BIGINT <<FK>>
    *descripcion : VARCHAR(255)
    *cantidad : NUMERIC(10,2)
    *precio_unitario : NUMERIC(12,2)
    *descuento : NUMERIC(5,2)
    *impuesto : NUMERIC(5,2)
    .. restricciones ..
    CHECK cantidad > 0
    CHECK descuento e impuesto entre 0 y 100
  }
  entity "concepto" as concepto {
    *id : BIGINT <<PK>>
    --
    *nombre : VARCHAR(100) <<UK>>
    *precio_base : NUMERIC(12,2)
    *impuesto : NUMERIC(5,2)
  }
  entity "documento_factura" as documento {
    *id : BIGINT <<PK>>
    --
    *factura_id : BIGINT <<FK, UK>> CASCADE
    *ruta_local : VARCHAR(255)
    ruta_nube : VARCHAR(255)
    *huella : CHAR(64)
    *firmado : BOOLEAN
    *creado_en : TIMESTAMPTZ
  }
  entity "solicitud_aprobacion" as solicitud {
    *id : BIGINT <<PK>>
    --
    factura_id : BIGINT <<FK>>
    excepcion_comercial_id : BIGINT <<FK>>
    propuesta_cambio_nivel_id : BIGINT <<FK>>
    *creada_por_id : BIGINT <<FK>>
    asignada_a_id : BIGINT <<FK>>
    resuelta_por_id : BIGINT <<FK>>
    *motivo : VARCHAR(255)
    *estado : VARCHAR(20)
    *fecha_solicitud : TIMESTAMPTZ
    fecha_resolucion : TIMESTAMPTZ
    motivo_decision : VARCHAR(255)
    .. restricciones ..
    CHECK num_nonnulls(factura_id, excepcion_comercial_id,
      propuesta_cambio_nivel_id) = 1
    CHECK resuelta_por_id <> creada_por_id
  }
}

package "Envíos y cobros" {
  entity "envio" as envio {
    *id : BIGINT <<PK>>
    --
    factura_id : BIGINT <<FK>>
    plantilla_id : BIGINT <<FK>>
    contacto_id : BIGINT <<FK>>
    *fecha : TIMESTAMPTZ
    *tipo : VARCHAR(20)
    *canal : VARCHAR(20)
    *destinatarios : TEXT
    *contenido_enviado : TEXT
    id_proveedor : VARCHAR(100)
    *reintentos : INTEGER
    resultado : VARCHAR(50)
    .. restricciones ..
    CHECK tipo = 'INFORME' OR factura_id IS NOT NULL
    CHECK reintentos >= 0
  }
  entity "plantilla_mensaje" as plantilla {
    *id : BIGINT <<PK>>
    --
    *tipo : VARCHAR(30)
    *idioma : CHAR(2)
    *asunto : VARCHAR(150)
    *cuerpo : TEXT
    *activa : BOOLEAN
    .. restricciones ..
    UNIQUE (tipo, idioma) WHERE activa
  }
  entity "cobro" as cobro {
    *id : BIGINT <<PK>>
    --
    *importe : NUMERIC(12,2)
    *moneda : CHAR(3)
    *fecha : DATE
    *origen : VARCHAR(20)
    *referencia : VARCHAR(100)
    *estado : VARCHAR(20)
    motivo_discrepancia : VARCHAR(255)
    .. restricciones ..
    UNIQUE (origen, referencia)
    CHECK importe > 0
  }
  entity "conciliacion" as conciliacion {
    *id : BIGINT <<PK>>
    --
    *cobro_id : BIGINT <<FK>>
    *factura_id : BIGINT <<FK>>
    validada_por_id : BIGINT <<FK>>
    revertida_por_id : BIGINT <<FK>>
    *importe_aplicado : NUMERIC(12,2)
    *fecha : TIMESTAMPTZ
    *estado : VARCHAR(20)
    fecha_reversion : TIMESTAMPTZ
    motivo_reversion : VARCHAR(255)
    .. restricciones ..
    CHECK importe_aplicado > 0
    CHECK estado <> 'REVERTIDA' OR (fecha_reversion
      y revertida_por_id NOT NULL)
    TRIGGER: Σ importe_aplicado VIGENTE <= cobro.importe
      y <= factura.total (PAGADA cuando Σ = total)
    IDX (factura_id) · IDX (cobro_id)
  }
  entity "pausa_recordatorios" as pausa {
    *id : BIGINT <<PK>>
    --
    *factura_id : BIGINT <<FK>> CASCADE
    incidencia_id : BIGINT <<FK>>
    *creada_por_id : BIGINT <<FK>>
    *motivo : VARCHAR(255)
    *inicio : TIMESTAMPTZ
    *fecha_revision : DATE
    fecha_reanudacion : TIMESTAMPTZ
    *activa : BOOLEAN
    .. restricciones ..
    UNIQUE (factura_id) WHERE activa
    CHECK activa = (fecha_reanudacion IS NULL)
  }
}

package "Seguimiento y control" {
  entity "incidencia" as incidencia {
    *id : BIGINT <<PK>>
    --
    *cliente_id : BIGINT <<FK>>
    factura_id : BIGINT <<FK>>
    *responsable_id : BIGINT <<FK>>
    *descripcion : TEXT
    *prioridad : VARCHAR(10)
    *estado : VARCHAR(10)
    *fecha_apertura : TIMESTAMPTZ
    fecha_cierre : TIMESTAMPTZ
    .. restricciones ..
    CHECK fecha_cierre >= fecha_apertura
  }
  entity "comentario" as comentario {
    *id : BIGINT <<PK>>
    --
    *incidencia_id : BIGINT <<FK>> CASCADE
    *autor_id : BIGINT <<FK>>
    autorizado_id : BIGINT <<FK>>
    *texto : TEXT
    *fecha : TIMESTAMPTZ
    *privado : BOOLEAN
    .. restricciones ..
    CHECK privado OR autorizado_id IS NULL
  }
  entity "adjunto" as adjunto {
    *id : BIGINT <<PK>>
    --
    *incidencia_id : BIGINT <<FK>> CASCADE
    *nombre : VARCHAR(255)
    *formato : VARCHAR(10)
    *tamano : BIGINT
    *ruta : VARCHAR(255)
    .. restricciones ..
    CHECK tamano > 0
  }
  entity "registro_auditoria" as auditoria {
    *id : BIGINT <<PK>>
    --
    usuario_id : BIGINT <<FK>>
    *fecha : TIMESTAMPTZ
    *accion : VARCHAR(50)
    *entidad : VARCHAR(50)
    *entidad_id : BIGINT
    valor_anterior : JSONB
    valor_nuevo : JSONB
    .. restricciones ..
    Solo INSERT (sin UPDATE ni DELETE)
    IDX (entidad, entidad_id, fecha)
  }
  entity "ejecucion_proceso" as ejecucion {
    *id : BIGINT <<PK>>
    --
    *proceso : VARCHAR(50)
    *inicio : TIMESTAMPTZ
    fin : TIMESTAMPTZ
    *completa : BOOLEAN
    resultado : TEXT
  }
  entity "copia_seguridad" as copia {
    *id : BIGINT <<PK>>
    --
    *fecha : TIMESTAMPTZ
    *estado : VARCHAR(20)
    *ubicacion : VARCHAR(255)
    *tamano : BIGINT
  }
}

package "Configuración e informes" {
  entity "configuracion" as configuracion {
    *id : BIGINT <<PK>>
    --
    *vigente_desde : TIMESTAMPTZ <<UK>>
    *plazo_pago_dias : INTEGER
    *cadencia_recordatorios : VARCHAR(50)
    *fecha_revision_anual : DATE
    *umbral_descuento : NUMERIC(12,2)
    *umbral_importe_atipico : NUMERIC(12,2)
    *umbral_rectificacion : NUMERIC(12,2)
    *minutos_bloqueo_acceso : INTEGER
    *retencion_exportaciones_dias : INTEGER
    *impuestos_permitidos : VARCHAR(100)
    correo_gestoria : VARCHAR(150)
    .. restricciones ..
    CHECK plazos, minutos y días > 0
  }
  entity "objetivo_financiero" as objetivo {
    *id : BIGINT <<PK>>
    --
    *definido_por_id : BIGINT <<FK>>
    *tipo : VARCHAR(30)
    *importe : NUMERIC(12,2)
    *moneda : CHAR(3)
    *vigente_desde : DATE
  }
  entity "exportacion" as exportacion {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>>
    programacion_id : BIGINT <<FK>>
    *tipo_informe : VARCHAR(50)
    *formato : VARCHAR(10)
    filtros : JSONB
    *fecha_generacion : TIMESTAMPTZ
    *caduca_el : DATE
    *ruta : VARCHAR(255)
  }
  entity "programacion_informe" as programacion {
    *id : BIGINT <<PK>>
    --
    *usuario_id : BIGINT <<FK>>
    *tipo_informe : VARCHAR(50)
    *periodicidad : VARCHAR(20)
    *destinatarios : TEXT
    *proxima_ejecucion : TIMESTAMPTZ
    *activa : BOOLEAN
  }
}

